# Frontend Environment Configuration
# ------------------------------------
# Production (Vercel / Docker build): set these to the production backend domain.
# If either variable is missing during a production build, the build will FAIL
# instead of silently falling back to localhost.
#
# Local development (npm run dev): these can be omitted; the defaults below
# (http://localhost:8000 / ws://localhost:8000) are used automatically.

VITE_API_BASE_URL=https://hackmateapi.dulify.in
VITE_WS_URL=wss://hackmateapi.dulify.in
